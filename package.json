{
  "name": "jayambadkar.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal website of Jay Ambadkar — jayambadkar.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:posts": "node scripts/fetch-posts.mjs",
    "prebuild": "node scripts/fetch-posts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=20.19"
  }
